"use client"

import { useState, useEffect } from "react"
import { FaPlay, FaStop, FaSync, FaExclamationTriangle, FaCheckCircle } from "react-icons/fa"
import simulationService from "../../services/simulationService"
import socketService from "../../services/socketService"

const SimulationPage = () => {
  const [settings, setSettings] = useState({
    is_enabled: false,
    generation_mode: "simulated",
    prediction_mode: "ml",
    pricing_mode: "simulated",
    irradiance: 800,
    temperature: 25,
    cloud_cover: 20,
    panel_efficiency: 0.18,
    demand_level: "medium",
    supply_level: "medium",
  })

  const [scenarios, setScenarios] = useState([])
  const [activeScenario, setActiveScenario] = useState(null)
  const [simulationResults, setSimulationResults] = useState(null)
  const [simulationRunning, setSimulationRunning] = useState(false)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState(null)
  const [success, setSuccess] = useState(null)
  const [simData, setSimData] = useState({
    generation: [],
    consumption: [],
    price: [],
  })
  const [showEditSettings, setShowEditSettings] = useState(false)

  useEffect(() => {
    fetchSettingsAndScenarios()

    // Connect to WebSocket for real-time updates
    socketService.connect()

    const simulationUpdateUnsubscribe = socketService.subscribe("simulation_updated", (data) => {
      console.log("Real-time simulation update:", data)
      if (data.generation) {
        setSimData((prev) => ({
          ...prev,
          generation: [
            ...prev.generation,
            {
              time: new Date().toLocaleTimeString(),
              value: data.generation,
            },
          ].slice(-20),
        }))
      }

      if (data.consumption) {
        setSimData((prev) => ({
          ...prev,
          consumption: [
            ...prev.consumption,
            {
              time: new Date().toLocaleTimeString(),
              value: data.consumption,
            },
          ].slice(-20),
        }))
      }

      if (data.price) {
        setSimData((prev) => ({
          ...prev,
          price: [
            ...prev.price,
            {
              time: new Date().toLocaleTimeString(),
              value: data.price,
            },
          ].slice(-20),
        }))
      }
    })

    return () => {
      simulationUpdateUnsubscribe()
      socketService.disconnect()
    }
  }, [])

  const fetchSettingsAndScenarios = async () => {
    setLoading(true)
    try {
      // Fetch current simulation settings
      const settingsResponse = await simulationService.getSimulationSettings()
      if (settingsResponse.success) {
        setSettings(settingsResponse.settings)
      } else {
        console.error("Failed to fetch simulation settings:", settingsResponse.error)
      }

      // Fetch available scenarios
      const scenariosResponse = await simulationService.getSimulationScenarios()
      if (scenariosResponse.success) {
        setScenarios(scenariosResponse.scenarios)
      } else {
        console.error("Failed to fetch simulation scenarios:", scenariosResponse.error)
      }
    } catch (err) {
      console.error("Error fetching simulation data:", err)
      setError("Failed to fetch simulation data")
    } finally {
      setLoading(false)
    }
  }

  const toggleSimulation = async () => {
    try {
      if (settings.is_enabled) {
        // Disable simulation
        const response = await simulationService.disableSimulation()
        if (response.success) {
          setSettings({ ...settings, is_enabled: false })
          setSimulationRunning(false)
          setSuccess("Simulation disabled successfully")
          setTimeout(() => setSuccess(null), 3000)
        } else {
          setError(response.error || "Failed to disable simulation")
        }
      } else {
        // Enable simulation
        const response = await simulationService.enableSimulation()
        if (response.success) {
          setSettings({ ...settings, is_enabled: true })
          setSimulationRunning(true)
          setSuccess("Simulation enabled successfully")
          setTimeout(() => setSuccess(null), 3000)
        } else {
          setError(response.error || "Failed to enable simulation")
        }
      }
    } catch (err) {
      console.error("Error toggling simulation:", err)
      setError("An error occurred while toggling simulation")
    }
  }

  const runSimulationStep = async () => {
    try {
      setSimulationRunning(true)
      const response = await simulationService.runSimulationStep()
      if (response.success) {
        setSimulationResults(response.results)
        setSuccess("Simulation step executed successfully")
        setTimeout(() => setSuccess(null), 3000)
      } else {
        setError(response.error || "Failed to run simulation step")
      }
      setSimulationRunning(false)
    } catch (err) {
      console.error("Error running simulation step:", err)
      setError("An error occurred while running simulation step")
      setSimulationRunning(false)
    }
  }

  const runSimulationPeriod = async () => {
    try {
      setSimulationRunning(true)
      const response = await simulationService.runSimulationPeriod(24)
      if (response.success) {
        setSimulationResults(response.results)
        setSuccess("Simulation period executed successfully")
        setTimeout(() => setSuccess(null), 3000)
      } else {
        setError(response.error || "Failed to run simulation period")
      }
      setSimulationRunning(false)
    } catch (err) {
      console.error("Error running simulation period:", err)
      setError("An error occurred while running simulation period")
      setSimulationRunning(false)
    }
  }

  const resetSimulation = async () => {
    if (window.confirm("Are you sure you want to reset the simulation? All simulation data will be deleted.")) {
      try {
        const response = await simulationService.resetSimulation()
        if (response.success) {
          setSimulationResults(null)
          setSimData({
            generation: [],
            consumption: [],
            price: [],
          })
          setSuccess("Simulation reset successfully")
          setTimeout(() => setSuccess(null), 3000)
        } else {
          setError(response.error || "Failed to reset simulation")
        }
      } catch (err) {
        console.error("Error resetting simulation:", err)
        setError("An error occurred while resetting simulation")
      }
    }
  }

  const applyScenario = async (scenarioId) => {
    try {
      const response = await simulationService.applySimulationScenario(scenarioId)
      if (response.success) {
        setSettings(response.settings)
        setActiveScenario(scenarioId)
        setSuccess("Scenario applied successfully")
        setTimeout(() => setSuccess(null), 3000)
      } else {
        setError(response.error || "Failed to apply scenario")
      }
    } catch (err) {
      console.error("Error applying scenario:", err)
      setError("An error occurred while applying scenario")
    }
  }

  const updateSettings = async () => {
    try {
      const response = await simulationService.updateSimulationSettings(settings)
      if (response.success) {
        setSettings(response.settings)
        setShowEditSettings(false)
        setSuccess("Settings updated successfully")
        setTimeout(() => setSuccess(null), 3000)
      } else {
        setError(response.error || "Failed to update settings")
      }
    } catch (err) {
      console.error("Error updating settings:", err)
      setError("An error occurred while updating settings")
    }
  }

  const handleSettingChange = (key, value) => {
    setSettings((prev) => ({
      ...prev,
      [key]: value,
    }))
  }

  // Convert simulation data to chart format
  const prepareChartData = () => {
    // Combine all data points based on time
    const timePoints = new Set()

    simData.generation.forEach((item) => timePoints.add(item.time))
    simData.consumption.forEach((item) => timePoints.add(item.time))
    simData.price.forEach((item) => timePoints.add(item.time))

    const sortedTimePoints = Array.from(timePoints).sort()

    return sortedTimePoints.map((time) => {
      const genPoint = simData.generation.find((item) => item.time === time)
      const consPoint = simData.consumption.find((item) => item.time === time)
      const pricePoint = simData.price.find((item) => item.time === time)

      return {
        time,
        generation: genPoint ? genPoint.value : undefined,
        consumption: consPoint ? consPoint.value : undefined,
        price: pricePoint ? pricePoint.value : undefined,
      }
    })
  }

  const chartData = prepareChartData()

  if (loading && Object.keys(settings).length === 0) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin rounded-full h-32 w-32 border-b-2 border-indigo-600"></div>
      </div>
    )
  }

  return (
    <div className="container mx-auto p-4">
      <div className="flex justify-between items-center mb-6">
        <div>
          <h1 className="text-3xl font-bold text-indigo-600">Energy Simulation</h1>
          <p className="text-gray-600">Simulate energy production and consumption patterns</p>
        </div>
        <div className="flex space-x-2">
          <button
            onClick={fetchSettingsAndScenarios}
            className="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-md flex items-center"
          >
            <FaSync className={loading ? "mr-2 animate-spin" : "mr-2"} />
            Refresh
          </button>

          <button
            onClick={toggleSimulation}
            className={`px-4 py-2 rounded-md flex items-center ${
              settings.is_enabled
                ? "bg-red-600 hover:bg-red-700 text-white"
                : "bg-green-600 hover:bg-green-700 text-white"
            }`}
          >
            {settings.is_enabled ? (
              <>
                <FaStop className="mr-2" />
                Stop Simulation
              </>
            ) : (
              <>
                <FaPlay className="mr-2" />
                Start Simulation
              </>
            )}
          </button>
        </div>
      </div>

      {/* Success Message */}
      {success && (
        <div className="bg-green-50 p-4 rounded-md border border-green-200 mb-6">
          <div className="flex items-center text-green-600">
            <FaCheckCircle className="mr-2" />
            <p>{success}</p>
          </div>
        </div>
      )}

      {/* Error Message */}
      {error && (
        <div className="bg-red-50 p-4 rounded-md border border-red-200 mb-6">
          <div className="flex items-center text-red-600">
            <FaExclamationTriangle className="mr-2" />
            <p>{error}</p>
          </div>
        </div>
      )}

      {/* Simulation Controls */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div className="bg-white rounded-lg shadow-md p-4">
          <h2 className="text-lg font-semibold mb-4">Simulation Controls</h2>
          <div className="space-y-4">
            <div className="flex flex-wrap gap-2">
              <button
                onClick={runSimulationStep}
                disabled={simulationRunning || !settings.is_enabled}
                className={`px-4 py-2 rounded-md ${
                  simulationRunning || !settings.is_enabled
                    ? "bg-gray-300 text-gray-500 cursor-not-allowed"
                    : "bg-blue-600 hover:bg-blue-700 text-white"
                }`}
              >
                Run Single Step
              </button>
              <button
                onClick={runSimulationPeriod}
                disabled={simulationRunning || !settings.is_enabled}
                className={`px-4 py-2 rounded-md ${
                  simulationRunning || !settings.is_enabled
                    ? "bg-gray-300 text-gray-500 cursor-not-allowed"
                    : "bg-blue-600 hover:bg-blue-700 text-white"
                }`}
              >
                Run 24 Hours
              </button>
              <button
                onClick={resetSimulation}
                disabled={simulationRunning}
                className={`px-4 py-2 rounded-md ${
                  simulationRunning
                    ? "bg-gray-300 text-gray-500 cursor-not-allowed"
                    : "bg-red-600 hover:bg-red-700 text-white"
                }`}
              >
                Reset Simulation
              </button>
            </div>

            <div className="mt-4">
              <h3 className="text-md font-medium mb-2">Current Settings</h3>
              <div className="bg-gray-50 p-4 rounded-md">
                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <p className="text-sm text-gray-600">Generation Mode:</p>
                    <p className="font-medium">{settings.generation_mode}</p>
                  </div>
                  <div>
                    <p className="text-sm text-gray-600">Prediction Mode:</p>
                    <p className="font-medium">{settings.prediction_mode}</p>
                  </div>
                  <div>
                    <p className="text-sm text-gray-600">Pricing Mode:</p>
                    <p className="font-medium">{settings.pricing_mode}</p>
                  </div>
                  <div>
                    <p className="text-sm text-gray-600">Panel Efficiency:</p>
                    <p className="font-medium">{settings.panel_efficiency}</p>
                  </div>
                  <div>
                    <p className="text-sm text-gray-600">Demand Level:</p>
                    <p className="font-medium">{settings.demand_level}</p>
                  </div>
                  <div>
                    <p className="text-sm text-gray-600">Supply Level:</p>
                    <p className="font-medium">{settings.supply_level}</p>
                  </div>
                </div>
                <button
                  onClick={() => setShowEditSettings(true)}
                  className="mt-4 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-md w-full"
                >
                  Edit Settings
                </button>
              </div>
            </div>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow-md p-4">
          <h2 className="text-lg font-semibold mb-4">Simulation Scenarios</h2>
          {scenarios.length > 0 ? (
            <div className="space-y-3">
              {scenarios.map((scenario) => (
                <div
                  key={scenario.id}
                  className={`p-3 rounded-md border ${
                    activeScenario === scenario.id
                      ? "border-indigo-500 bg-indigo-50"
                      : "border-gray-200 hover:bg-gray-50"
                  }`}
                >
                  <div className="flex justify-between items-center">
                    <div>
                      <h3 className="font-medium">{scenario.name}</h3>
                      <p className="text-sm text-gray-600">{scenario.description}</p>
                    </div>
                    <button
                      onClick={() => applyScenario(scenario.id)}
                      disabled={simulationRunning}
                      className={`px-3 py-1 rounded-md ${
                        simulationRunning
                          ? "bg-gray-300 text-gray-500 cursor-not-allowed"
                          : activeScenario === scenario.id
                            ? "bg-indigo-600 text-white"
                            : "bg-indigo-100 text-indigo-700 hover:bg-indigo-200"
                      }`}
                    >
                      {activeScenario === scenario.id ? "Applied" : "Apply"}
                    </button>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div className="text-center py-8 text-gray-500">
              <p>No scenarios available</p>
            </div>
          )}
        </div>
      </div>

      {/* Simulation Results */}
      {simulationResults && (
        <div className="bg-white rounded-lg shadow-md p-4 mb-6">
          <h2 className="text-lg font-semibold mb-4">Latest Simulation Results</h2>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div className="bg-green-50 p-4 rounded-md">
              <h3 className="font-medium text-green-700">Energy Production</h3>
              <p className="text-2xl font-bold">{simulationResults.production.toFixed(2)} kWh</p>
            </div>
            <div className="bg-blue-50 p-4 rounded-md">
              <h3 className="font-medium text-blue-700">Energy Consumption</h3>
              <p className="text-2xl font-bold">{simulationResults.consumption.toFixed(2)} kWh</p>
            </div>
            <div className="bg-purple-50 p-4 rounded-md">
              <h3 className="font-medium text-purple-700">Market Price</h3>
              <p className="text-2xl font-bold">${simulationResults.price.toFixed(4)}/kWh</p>
            </div>
          </div>
        </div>
      )}

      {/* Edit Settings Modal */}
      {showEditSettings && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-lg shadow-lg p-6 w-full max-w-md">
            <h2 className="text-xl font-semibold mb-4">Edit Simulation Settings</h2>

            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Generation Mode</label>
                <select
                  className="w-full px-3 py-2 border border-gray-300 rounded-md"
                  value={settings.generation_mode}
                  onChange={(e) => handleSettingChange("generation_mode", e.target.value)}
                >
                  <option value="simulated">Simulated</option>
                  <option value="real">Real</option>
                  <option value="hybrid">Hybrid</option>
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Prediction Mode</label>
                <select
                  className="w-full px-3 py-2 border border-gray-300 rounded-md"
                  value={settings.prediction_mode}
                  onChange={(e) => handleSettingChange("prediction_mode", e.target.value)}
                >
                  <option value="ml">Machine Learning</option>
                  <option value="statistical">Statistical</option>
                  <option value="simple">Simple</option>
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Pricing Mode</label>
                <select
                  className="w-full px-3 py-2 border border-gray-300 rounded-md"
                  value={settings.pricing_mode}
                  onChange={(e) => handleSettingChange("pricing_mode", e.target.value)}
                >
                  <option value="simulated">Simulated</option>
                  <option value="fixed">Fixed</option>
                  <option value="dynamic">Dynamic</option>
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Panel Efficiency ({settings.panel_efficiency})
                </label>
                <input
                  type="range"
                  min="0.1"
                  max="0.3"
                  step="0.01"
                  value={settings.panel_efficiency}
                  onChange={(e) => handleSettingChange("panel_efficiency", Number.parseFloat(e.target.value))}
                  className="w-full"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Demand Level</label>
                <select
                  className="w-full px-3 py-2 border border-gray-300 rounded-md"
                  value={settings.demand_level}
                  onChange={(e) => handleSettingChange("demand_level", e.target.value)}
                >
                  <option value="low">Low</option>
                  <option value="medium">Medium</option>
                  <option value="high">High</option>
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Supply Level</label>
                <select
                  className="w-full px-3 py-2 border border-gray-300 rounded-md"
                  value={settings.supply_level}
                  onChange={(e) => handleSettingChange("supply_level", e.target.value)}
                >
                  <option value="low">Low</option>
                  <option value="medium">Medium</option>
                  <option value="high">High</option>
                </select>
              </div>
            </div>

            <div className="flex justify-end space-x-3 mt-6">
              <button
                onClick={() => setShowEditSettings(false)}
                className="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
              >
                Cancel
              </button>
              <button
                onClick={updateSettings}
                className="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
              >
                Save Settings
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

export default SimulationPage
